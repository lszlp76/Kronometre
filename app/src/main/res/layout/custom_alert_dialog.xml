<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:alpha="1"
    android:padding="20dp"
    android:background="@drawable/glass_panel_background">

    <TextView
        android:id="@+id/dialogTitle"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UYARI BAŞLIĞI"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        style="@style/TableText"
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="2"
        android:textColor="#E0E0E0"
        android:text="Bu, özelleştirilmiş bir uyarı metnidir."
        android:textSize="16sp"

        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp"
        android:visibility="gone">

        <EditText
            style="@style/DialogInputStyle"
            android:id="@+id/dialogFileNameInput"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="...."
            android:textColor="#FFFFFF"
            android:background="@null"
            android:backgroundTint="#00FFE5"/>

        <ImageButton
            android:id="@+id/btnVoiceInput"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_mic_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voice_input"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <EditText
        style="@style/DialogInputStyle"
        android:id="@+id/dialogNoteInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColorHint="#FFB899"
        android:textColor="#FFFFFF"

        android:backgroundTint="#00FFE5"
        android:visibility="gone"
        android:layout_marginBottom="20dp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <com.google.android.material.button.MaterialButton
            style="@style/ButtonAdjustmentStyle"
            android:id="@+id/btnNegative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            app:backgroundTint="@color/btn_color"
            android:layout_marginEnd="10dp"/>

        <com.google.android.material.button.MaterialButton
            style="@style/ButtonAdjustmentStyle"
            android:id="@+id/btnPositive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            app:backgroundTint="@color/btn_color"
            />

    </LinearLayout>

</LinearLayout>